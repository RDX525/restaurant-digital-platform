# =============================================================================
# Restaurant Digital Platform — environment template
# Copy to .env.local for development. Set in your hosting provider for production.
# Never commit real secrets. See ENVIRONMENT_VARIABLES.md for full reference.
# =============================================================================

# --- Required (production) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ACCESS_TOKEN_SECRET=generate-a-random-32-char-secret

# --- Payment (production: must not be "demo") ---
PAYMENT_PROVIDER=demo
# For production Stripe checkout:
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_live_...
# PAYMENT_STRIPE_WEBHOOK_SECRET=whsec_...

# Demo payment webhook secret (development / demo provider only)
PAYMENT_DEMO_WEBHOOK_SECRET=demo-webhook-secret-change-me

# --- Notifications (production: resend + twilio or accept demo logging) ---
NOTIFICATION_PROVIDER=demo
# Or split providers explicitly:
# NOTIFICATION_EMAIL_PROVIDER=resend
# NOTIFICATION_SMS_PROVIDER=twilio
NOTIFICATION_DEMO_SIMULATE_FAILURE=false
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=notifications@yourdomain.com
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+1...

# --- Scheduled jobs (Vercel Cron sends Authorization: Bearer CRON_SECRET) ---
# CRON_SECRET=generate-a-random-32-char-secret

# --- Distributed rate limiting (recommended for production) ---
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# --- Intelligence ---
INTELLIGENCE_PROVIDER=demo
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# --- Development only (never set in production) ---
# NEXT_PUBLIC_DEMO_RESTAURANT_ID=00000000-0000-4000-8000-000000000001
# ENABLE_DEMO_AUTH=true

# --- Standard (set by platform) ---
# NODE_ENV=production
